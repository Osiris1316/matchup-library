{
  "name": "matchup-library",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:api": "wrangler dev",
    "dev:web": "cd packages/web && pnpm dev",
    "dev": "pnpm build:web && concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
    "build:web": "cd packages/web && pnpm build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "migrate:local": "wrangler d1 migrations apply matchup-library --local",
    "migrate:remote": "wrangler d1 migrations apply matchup-library --remote",
    "import-preview": "tsx scripts/import-preview.ts",
    "subjects": "tsx scripts/subjects.ts",
    "backup-order": "tsx scripts/backup-order.ts",
    "deploy": "pnpm build:web && wrangler deploy"
  },
  "devDependencies": {
    "@matchup-library/core": "workspace:*",
    "concurrently": "9.2.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.153.0"
  }
}
