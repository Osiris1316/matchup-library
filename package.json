{
  "name": "matchup-library",
  "version": "1.0.0",
  "private": true,
  "description": "AoE4 matchup library: elements, plays, civ tags, maps and references, on Cloudflare Workers and D1.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply matchup-library --local",
    "migrate:remote": "wrangler d1 migrations apply matchup-library --remote",
    "import-preview": "node scripts/import-preview.mjs"
  },
  "dependencies": {
    "jose": "6.2.13"
  },
  "devDependencies": {
    "wrangler": "4.151.3"
  }
}
