{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "matchup-library",
	"main": "packages/api/src/worker.ts",
	"compatibility_date": "2026-10-01",
	// One Worker serves the built page and the API, so one Access setting covers
	// the whole site. /api always reaches the Worker. Anything else that matches
	// a built file is served directly, and every other page address (/civs/rus,
	// /versus?...) gets index.html, where the page's router takes over.
	// Build the page first: `pnpm build:web` (or `pnpm run deploy`, which does both).
	"assets": {
		"directory": "./packages/web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "matchup-library",
			"database_id": "b62bd00b-314e-4ae7-aaf7-b721a1e63044",
			"migrations_dir": "packages/core/src/db/migrations"
		}
	],
	"observability": {
		"enabled": true
	}
}